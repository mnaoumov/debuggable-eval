{
  "name": "debuggable-eval",
  "version": "2.2.1",
  "description": "Makes eval() debugger-friendly with ability to set breakpoints and see proper line numbers in Error stack traces.",
  "keywords": [
    "eval"
  ],
  "homepage": "https://github.com/mnaoumov/debuggable-eval#readme",
  "bugs": {
    "url": "https://github.com/mnaoumov/debuggable-eval/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnaoumov/debuggable-eval.git"
  },
  "license": "MIT",
  "author": "Michael Naumov",
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/lib/esm/index.d.mts",
      "default": "./dist/lib/esm/index.mjs"
    },
    "require": {
      "types": "./dist/lib/cjs/index.d.cts",
      "default": "./dist/lib/cjs/index.cjs"
    }
  },
  "main": "dist/lib/cjs/index.cjs",
  "module": "dist/lib/esm/index.mjs",
  "types": "dist/lib/esm/index.d.mts",
  "files": [
    "dist/",
    "!dist/*.tgz",
    "!dist/*.zip",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "npm run build:compile && npm run build:types",
    "build:compile": "jiti scripts/build-compile.ts",
    "build:types": "jiti scripts/build-types.ts",
    "check:vendored-eslint-rules": "jiti scripts/check-vendored-eslint-rules.ts",
    "commit": "jiti scripts/commit.ts",
    "format": "jiti scripts/format.ts",
    "format:check": "jiti scripts/format-check.ts",
    "lint": "jiti scripts/lint.ts",
    "lint:fix": "jiti scripts/lint-fix.ts",
    "lint:md": "jiti scripts/lint-md.ts",
    "lint:md:fix": "jiti scripts/lint-md-fix.ts",
    "prepare": "jiti scripts/prepare.ts",
    "spellcheck": "jiti scripts/spellcheck.ts",
    "test": "vitest run",
    "test:coverage": "jiti scripts/test-coverage.ts",
    "version": "jiti scripts/version.ts"
  },
  "overrides": {
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.16.2",
    "type-fest": "^5.5.0"
  },
  "dependencies": {
    "acorn": "^8.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/utils": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "better-typescript-lib": "^2.12.0",
    "cspell": "^10.0.0",
    "czg": "^1.13.1",
    "dedent": "^1.7.2",
    "dprint": "^0.54.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.22.0",
    "markdownlint-rule-relative-links": "^5.1.0",
    "nano-staged": "^1.0.2",
    "semver": "^7.7.4",
    "type-fest": "^5.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
